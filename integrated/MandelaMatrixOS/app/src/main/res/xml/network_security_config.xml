<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is denied everywhere EXCEPT loopback, where local LLM
  servers live (Ollama / llama.cpp / LM Studio / OpenAI-compatible endpoints).
  All cloud providers (Gemini, Groq, OpenRouter) are HTTPS.
  10.0.2.2 = host machine when running inside an emulator.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
